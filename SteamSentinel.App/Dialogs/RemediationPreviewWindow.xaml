<Window x:Class="SteamSentinel.App.Dialogs.RemediationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:SteamSentinel.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ui:Text Ui.Xaml.RemediationPreviewWindow.001}"
        Width="860" Height="620" MinWidth="456" MinHeight="400"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        ResizeMode="CanResize" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid x:Name="PreviewLayout" Margin="12" SizeChanged="PreviewLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.RemediationPreviewWindow.002}" TextWrapping="Wrap" />
        <Border Grid.Row="1" Margin="0,6,0,6" Background="#FFF4ED" BorderBrush="#FFB088" BorderThickness="1" CornerRadius="6" Padding="8">
            <TextBlock Text="{ui:Text Ui.Xaml.RemediationPreviewWindow.003}" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="PreviewTabs" Grid.Row="2">
            <TabItem Header="{ui:Text Ui.Xaml.RemediationPreviewWindow.004}">
                <DataGrid x:Name="PreviewActionsGrid" ItemsSource="{Binding GroupedActions}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserResizeColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Target, StringFormat={ui:Text Ui.Xaml.RemediationPreviewWindow.005}}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Group, StringFormat={ui:Text Ui.Xaml.RemediationPreviewWindow.006}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding ExpectedIdentity, StringFormat={ui:Text Ui.Xaml.RemediationPreviewWindow.007}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{ui:Text Ui.Xaml.RemediationPreviewWindow.008}" Width="112" MinWidth="112" HeaderStyle="{StaticResource GridCenteredHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource GridCellText}" TextAlignment="Center" />
                                        <TextBlock Text="{Binding Batch, StringFormat={ui:Text Ui.Xaml.RemediationPreviewWindow.009}}" Style="{StaticResource GridCenteredText}" Foreground="#667085" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{ui:Text Ui.Xaml.RemediationPreviewWindow.010}" Binding="{Binding Confidence}" Width="92" MinWidth="92" HeaderStyle="{StaticResource GridCenteredHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCenteredText}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextTrimming" Value="None" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{ui:Text Ui.Xaml.RemediationPreviewWindow.011}" Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontWeight="SemiBold" ToolTip="{Binding DisplayName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridPathText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="compact">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Target}" Style="{StaticResource GridPathText}" ToolTip="{Binding Target}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{ui:Text Ui.Xaml.RemediationPreviewWindow.012}">
                <DataGrid x:Name="PreviewOmittedGrid" ItemsSource="{Binding OmittedTargets}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserResizeColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Target, StringFormat={ui:Text Ui.Xaml.RemediationPreviewWindow.013}}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Reason, StringFormat={ui:Text Ui.Xaml.RemediationPreviewWindow.014}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{ui:Text Ui.Xaml.RemediationPreviewWindow.015}" Binding="{Binding Target}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="MaxHeight" Value="56" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{ui:Text Ui.Xaml.RemediationPreviewWindow.016}" Binding="{Binding Reason}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="MaxHeight" Value="56" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{ui:Text Ui.Xaml.RemediationPreviewWindow.017}">
                <ScrollViewer x:Name="PreviewNoticeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{ui:Text Ui.Xaml.RemediationPreviewWindow.018}" TextWrapping="Wrap" Foreground="#667085" Margin="0,8,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="{ui:Text Ui.Xaml.RemediationPreviewWindow.019}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding PlanNotes}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <CheckBox x:Name="ConfirmCheckBox" Grid.Row="3" Margin="0,10,0,0" HorizontalContentAlignment="Stretch"
                  Checked="ConfirmCheckBox_Changed" Unchecked="ConfirmCheckBox_Changed">
            <TextBlock Text="{ui:Text Ui.Xaml.RemediationPreviewWindow.020}" TextWrapping="Wrap" />
        </CheckBox>

        <WrapPanel x:Name="PreviewActionsBar" Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelPreviewButton" Content="{ui:Text Ui.Xaml.RemediationPreviewWindow.021}" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ExecuteButton" Style="{StaticResource PrimaryButton}" IsEnabled="False" Content="{ui:Text Ui.Xaml.RemediationPreviewWindow.022}" Click="Execute_Click" Margin="0" />
        </WrapPanel>
    </Grid>
</Window>
