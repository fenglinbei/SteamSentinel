<Window x:Class="SteamSentinel.App.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加密内容需要密码" Width="640" Height="620" MinWidth="460" MinHeight="340"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding PromptTitle}" TextWrapping="Wrap" />
                <Border Margin="0,12,0,0" Background="#FFFAEB" BorderBrush="#FEDF89" BorderThickness="1" CornerRadius="6" Padding="12">
                    <TextBlock Text="{Binding Request.Reason}" TextWrapping="Wrap" Foreground="#93370D" />
                </Border>
                <TextBlock Margin="0,10,0,14" Foreground="#667085" TextWrapping="Wrap"
                           Text="请输入你获得的解压密码，也可以跳过。未解开的内容会标记为“未完整扫描”，不会被当成安全。" />
                <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding Request.ArchivePath}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Request.ArchivePath}" />
                        <Expander Header="查看完整内容位置与哈希" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Request.ArchivePath}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="{Binding Request.ArchiveSha256}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap">
                            <Run Text="格式："/><Run Text="{Binding Request.Format}"/><Run Text="　嵌套层级："/><Run Text="{Binding Request.Depth}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="解压密码" />
                <PasswordBox x:Name="PasswordInput" Margin="0,6,0,12" Height="36" Padding="8" MaxLength="1024" />
                <TextBlock FontWeight="SemiBold" Text="成功解密后，在哪里复用这个密码？" TextWrapping="Wrap" />
                <RadioButton x:Name="CurrentOnlyRadio" GroupName="Scope" Margin="0,10,0,0" Content="只用于当前这一层" />
                <RadioButton x:Name="ArchiveTreeRadio" GroupName="Scope" Margin="0,10,0,0" IsChecked="True" Content="当前外层文件及其中的嵌套包" />
                <RadioButton x:Name="SessionRadio" GroupName="Scope" Margin="0,10,0,0" Content="本次扫描遇到的所有压缩包" />
                <TextBlock Margin="0,14,0,0" Foreground="#667085" TextWrapping="Wrap"
                           Text="只复用已验证的密码，不会破解密码。跳过后，本次相同内容不再询问，可在扫描结束后点击“重试未解密内容”补充密码。密码只在本次扫描内存中使用，不写入文件、日志或命令行。" />
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="跳过这一层" IsCancel="True" Click="Skip_Click" />
            <Button Style="{StaticResource PrimaryButton}" Content="使用密码继续" IsDefault="True" Click="Continue_Click" />
        </WrapPanel>
    </Grid>
</Window>
