<Window x:Class="SteamSentinel.App.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加密内容需要密码"
        Width="610" Height="500" MinHeight="470"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="SemiBold" Text="发现加密压缩包" />
        <TextBlock Grid.Row="1" Margin="0,10,0,14" Foreground="#667085" TextWrapping="Wrap"
                   Text="不提供密码时，程序无法检查内部内容，扫描结果将明确标记为“未完整扫描”。程序不会尝试破解密码。" />

        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding Request.ArchivePath}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Request.Reason}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Foreground="#667085">
                    <Run Text="格式："/><Run Text="{Binding Request.Format}"/><Run Text="　嵌套层级："/><Run Text="{Binding Request.Depth}"/>
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Foreground="#667085" Text="{Binding Request.ArchiveSha256}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock FontWeight="SemiBold" Text="密码" />
            <PasswordBox x:Name="PasswordInput" Margin="0,6,0,0" Height="36" Padding="8" />
            <CheckBox x:Name="ReuseCheckBox" Margin="0,10,0,0"
                      Content="仅在本次扫描会话中，对相同内容哈希复用此密码" />
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap"
                   Text="密码不会保存、写入日志或通过命令行传递，但和所有桌面程序一样，它会在进程内存中短暂存在。" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="跳过并标记未完整" IsCancel="True" Click="Skip_Click" />
            <Button Style="{StaticResource PrimaryButton}" Content="使用密码继续" IsDefault="True" Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
