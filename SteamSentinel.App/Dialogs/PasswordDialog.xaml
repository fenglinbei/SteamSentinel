<Window x:Class="SteamSentinel.App.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加密内容需要密码" Width="580" Height="550" MinWidth="436" MinHeight="380"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        ResizeMode="CanResize" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid x:Name="PasswordLayout" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="PasswordContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding PromptTitle}" TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0" Foreground="#667085" TextWrapping="Wrap"
                           Text="输入密码或跳过；未解开会标记为“未完整扫描”。" />
                <Border Margin="0,6,0,0" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="6">
                    <TextBlock Text="{Binding Request.ArchivePath}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Request.ArchivePath}" />
                </Border>
                <DockPanel Margin="0,8,0,0">
                    <CheckBox x:Name="PasswordMultipleCheckBox" DockPanel.Dock="Right" Content="多个密码（依次尝试）"
                              ToolTip="逐个加入候选密码，按加入顺序尝试。候选列表始终遮蔽显示，不按空格或逗号拆分。"
                              Checked="PasswordMode_Changed" Unchecked="PasswordMode_Changed" />
                    <TextBlock FontWeight="SemiBold" Text="解压密码" />
                </DockPanel>
                <DockPanel Margin="0,4,0,6" KeyboardNavigation.TabNavigation="Local">
                    <Button x:Name="AddPasswordButton" DockPanel.Dock="Right" Content="加入" Margin="6,0,0,0" Visibility="Collapsed" KeyboardNavigation.TabIndex="2"
                            ToolTip="将当前密码加入候选列表；按 Enter 也可加入。" Click="AddPassword_Click" />
                    <Button x:Name="PasswordVisibilityButton" DockPanel.Dock="Right" Width="32" Height="32" Padding="6" Margin="6,0,0,0" KeyboardNavigation.TabIndex="1"
                            ToolTip="显示当前输入的密码" AutomationProperties.Name="显示密码"
                            AutomationProperties.HelpText="只影响当前输入框，候选密码列表始终遮蔽显示。" Click="PasswordVisibility_Click">
                        <Grid Width="18" Height="18" IsHitTestVisible="False">
                            <Path Data="M 1,9 C 5,2 13,2 17,9 C 13,16 5,16 1,9 Z M 11.5,9 A 2.5,2.5 0 1 1 6.5,9 A 2.5,2.5 0 1 1 11.5,9"
                                  Stroke="{Binding Foreground, ElementName=PasswordVisibilityButton}" StrokeThickness="1.5" Fill="Transparent" />
                            <Path x:Name="PasswordVisibilitySlash" Data="M 2,2 L 16,16" Stroke="{Binding Foreground, ElementName=PasswordVisibilityButton}"
                                  StrokeThickness="1.5" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Grid KeyboardNavigation.TabIndex="0">
                        <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="解压密码" Height="32" Padding="6"
                                     PreviewKeyDown="PasswordInput_PreviewKeyDown" PasswordChanged="PasswordInput_PasswordChanged"
                                     DataObject.Pasting="PasswordInput_Pasting" />
                        <TextBox x:Name="PasswordVisibleInput" AutomationProperties.Name="解压密码，当前为显示状态" Visibility="Collapsed"
                                 Height="32" Padding="6" VerticalContentAlignment="Center" IsUndoEnabled="False" SpellCheck.IsEnabled="False"
                                 PreviewKeyDown="PasswordInput_PreviewKeyDown" TextChanged="PasswordVisibleInput_TextChanged"
                                 DataObject.Pasting="PasswordInput_Pasting" />
                    </Grid>
                </DockPanel>
                <TextBlock x:Name="PasswordValidationText" Foreground="#B42318" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
                <TextBlock x:Name="PasswordScopeTitleText" FontWeight="SemiBold" Text="成功解密后的密码复用范围" TextWrapping="Wrap" />
                <RadioButton x:Name="CurrentOnlyRadio" GroupName="Scope" Margin="0,4,0,0" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="只用于当前这一层" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton x:Name="ArchiveTreeRadio" GroupName="Scope" Margin="0,4,0,0" IsChecked="True" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="当前外层文件及其中的嵌套包" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton x:Name="SessionRadio" GroupName="Scope" Margin="0,4,0,0" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="本次扫描遇到的所有压缩包" TextWrapping="Wrap" />
                </RadioButton>
                <TextBlock Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap"
                           Text="密码仅在本次扫描内存中使用，不破解、不保存。" />
                <Border x:Name="PasswordCandidatesPanel" Visibility="Collapsed" Margin="0,6,0,0" Background="#F9FAFB"
                        BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="6">
                    <StackPanel>
                        <TextBlock Text="逐个加入，按顺序尝试；空格保留，每个最多 1024 字符。" TextWrapping="Wrap" />
                        <ListBox x:Name="PasswordCandidatesList" AutomationProperties.Name="遮蔽的候选密码列表，按加入顺序"
                                 Height="68" Margin="0,4,0,4" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="PasswordCandidates_SelectionChanged" />
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button x:Name="RemovePasswordButton" Content="移除选中" IsEnabled="False" Click="RemovePassword_Click" />
                                <Button x:Name="ClearPasswordsButton" Content="清空列表" IsEnabled="False" Margin="0" Click="ClearPasswords_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="PasswordCandidateStatusText" Text="0 / 16 个候选" VerticalAlignment="Center" Foreground="#667085" />
                        </DockPanel>
                        <TextBlock Text="候选密码会在所选范围内依次尝试；点击继续时，未加入的输入会追加到列表末尾。" TextWrapping="Wrap" Foreground="#667085" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Expander x:Name="PasswordDetailsExpander" Header="查看原因、完整位置与密码使用说明" Margin="0,6,0,0">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Foreground="#667085" TextWrapping="Wrap">
                                <Run Text="格式："/><Run Text="{Binding Request.Format}"/><Run Text="　嵌套层级："/><Run Text="{Binding Request.Depth}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Request.Reason}" TextWrapping="Wrap" Foreground="#93370D" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding Request.ArchivePath}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0" Foreground="#667085" Text="{Binding Request.ArchiveSha256}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Foreground="#667085" TextWrapping="Wrap"
                                       Text="单密码只在成功解密后复用；多个候选密码会按加入顺序，在所选范围内逐个尝试。未解开的内容不会被当成安全。跳过这一层后，本次相同内容不再询问；跳过全部未解密包仅限本次扫描，仍会先尝试适用密码，未解开时不再弹窗并标记未检查。扫描结束后可点击“重试未解密内容”补充密码。密码不写入文件、日志或命令行。" />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel x:Name="PasswordActionsBar" Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SkipAllEncryptedButton" Content="本次全部跳过"
                    ToolTip="跳过所有未能解密的加密压缩包：仅限本次扫描，仍先尝试适用密码；未解开时不再弹窗并标记未检查，之后可重试。"
                    Click="SkipAllEncrypted_Click" />
            <Button x:Name="SkipPasswordButton" Content="跳过这一层" IsCancel="True" Click="Skip_Click" />
            <Button x:Name="ContinuePasswordButton" Style="{StaticResource PrimaryButton}" Content="使用密码继续" IsDefault="True" Click="Continue_Click" Margin="0" />
        </WrapPanel>
    </Grid>
</Window>
