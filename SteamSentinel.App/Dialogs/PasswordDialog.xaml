<Window x:Class="SteamSentinel.App.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:SteamSentinel.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{ui:Text Ui.Xaml.PasswordDialog.001}" Width="580" Height="550" MinWidth="436" MinHeight="380"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        ResizeMode="CanResize" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid x:Name="PasswordLayout" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="PasswordContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding PromptTitle}" TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0" Foreground="#667085" TextWrapping="Wrap"
                           Text="{ui:Text Ui.Xaml.PasswordDialog.002}" />
                <Border Margin="0,6,0,0" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="6">
                    <TextBlock Text="{Binding Request.ArchivePath}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Request.ArchivePath}" />
                </Border>
                <DockPanel Margin="0,8,0,0">
                    <CheckBox x:Name="PasswordMultipleCheckBox" DockPanel.Dock="Right" Content="{ui:Text Ui.Xaml.PasswordDialog.003}"
                              ToolTip="{ui:Text Ui.Xaml.PasswordDialog.004}"
                              Checked="PasswordMode_Changed" Unchecked="PasswordMode_Changed" />
                    <TextBlock FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.PasswordDialog.005}" />
                </DockPanel>
                <DockPanel Margin="0,4,0,6" KeyboardNavigation.TabNavigation="Local">
                    <Button x:Name="AddPasswordButton" DockPanel.Dock="Right" Content="{ui:Text Ui.Xaml.PasswordDialog.006}" Margin="6,0,0,0" Visibility="Collapsed" KeyboardNavigation.TabIndex="2"
                            ToolTip="{ui:Text Ui.Xaml.PasswordDialog.007}" Click="AddPassword_Click" />
                    <Button x:Name="PasswordVisibilityButton" DockPanel.Dock="Right" Width="32" Height="32" Padding="6" Margin="6,0,0,0" KeyboardNavigation.TabIndex="1"
                            ToolTip="{ui:Text Ui.Xaml.PasswordDialog.008}" AutomationProperties.Name="{ui:Text Ui.Xaml.PasswordDialog.009}"
                            AutomationProperties.HelpText="{ui:Text Ui.Xaml.PasswordDialog.010}" Click="PasswordVisibility_Click">
                        <Grid Width="18" Height="18" IsHitTestVisible="False">
                            <Path Data="M 1,9 C 5,2 13,2 17,9 C 13,16 5,16 1,9 Z M 11.5,9 A 2.5,2.5 0 1 1 6.5,9 A 2.5,2.5 0 1 1 11.5,9"
                                  Stroke="{Binding Foreground, ElementName=PasswordVisibilityButton}" StrokeThickness="1.5" Fill="Transparent" />
                            <Path x:Name="PasswordVisibilitySlash" Data="M 2,2 L 16,16" Stroke="{Binding Foreground, ElementName=PasswordVisibilityButton}"
                                  StrokeThickness="1.5" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Grid KeyboardNavigation.TabIndex="0">
                        <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="{ui:Text Ui.Xaml.PasswordDialog.011}" Height="32" Padding="6"
                                     PreviewKeyDown="PasswordInput_PreviewKeyDown" PasswordChanged="PasswordInput_PasswordChanged"
                                     DataObject.Pasting="PasswordInput_Pasting" />
                        <TextBox x:Name="PasswordVisibleInput" AutomationProperties.Name="{ui:Text Ui.Xaml.PasswordDialog.012}" Visibility="Collapsed"
                                 Height="32" Padding="6" VerticalContentAlignment="Center" IsUndoEnabled="False" SpellCheck.IsEnabled="False"
                                 PreviewKeyDown="PasswordInput_PreviewKeyDown" TextChanged="PasswordVisibleInput_TextChanged"
                                 DataObject.Pasting="PasswordInput_Pasting" />
                    </Grid>
                </DockPanel>
                <TextBlock x:Name="PasswordValidationText" Foreground="#B42318" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
                <TextBlock x:Name="PasswordScopeTitleText" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.PasswordDialog.013}" TextWrapping="Wrap" />
                <RadioButton x:Name="CurrentOnlyRadio" GroupName="Scope" Margin="0,4,0,0" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="{ui:Text Ui.Xaml.PasswordDialog.014}" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton x:Name="ArchiveTreeRadio" GroupName="Scope" Margin="0,4,0,0" IsChecked="True" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="{ui:Text Ui.Xaml.PasswordDialog.015}" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton x:Name="SessionRadio" GroupName="Scope" Margin="0,4,0,0" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="{ui:Text Ui.Xaml.PasswordDialog.016}" TextWrapping="Wrap" />
                </RadioButton>
                <TextBlock Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap"
                           Text="{ui:Text Ui.Xaml.PasswordDialog.017}" />
                <Border x:Name="PasswordCandidatesPanel" Visibility="Collapsed" Margin="0,6,0,0" Background="#F9FAFB"
                        BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="6">
                    <StackPanel>
                        <TextBlock Text="{ui:Text Ui.Xaml.PasswordDialog.018}" TextWrapping="Wrap" />
                        <ListBox x:Name="PasswordCandidatesList" AutomationProperties.Name="{ui:Text Ui.Xaml.PasswordDialog.019}"
                                 Height="68" Margin="0,4,0,4" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="PasswordCandidates_SelectionChanged" />
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button x:Name="RemovePasswordButton" Content="{ui:Text Ui.Xaml.PasswordDialog.020}" IsEnabled="False" Click="RemovePassword_Click" />
                                <Button x:Name="ClearPasswordsButton" Content="{ui:Text Ui.Xaml.PasswordDialog.021}" IsEnabled="False" Margin="0" Click="ClearPasswords_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="PasswordCandidateStatusText" Text="{ui:Text Ui.Xaml.PasswordDialog.022}" VerticalAlignment="Center" Foreground="#667085" />
                        </DockPanel>
                        <TextBlock Text="{ui:Text Ui.Xaml.PasswordDialog.023}" TextWrapping="Wrap" Foreground="#667085" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Expander x:Name="PasswordDetailsExpander" Header="{ui:Text Ui.Xaml.PasswordDialog.024}" Margin="0,6,0,0">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Foreground="#667085" TextWrapping="Wrap">
                                <Run Text="{ui:Text Ui.Xaml.PasswordDialog.025}"/><Run Text="{Binding Request.Format}"/><Run Text="{ui:Text Ui.Xaml.PasswordDialog.026}"/><Run Text="{Binding Request.Depth}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Request.Reason}" TextWrapping="Wrap" Foreground="#93370D" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding Request.ArchivePath}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0" Foreground="#667085" Text="{Binding Request.ArchiveSha256}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Foreground="#667085" TextWrapping="Wrap"
                                       Text="{ui:Text Ui.Xaml.PasswordDialog.027}" />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel x:Name="PasswordActionsBar" Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SkipAllEncryptedButton" Content="{ui:Text Ui.Xaml.PasswordDialog.028}"
                    ToolTip="{ui:Text Ui.Xaml.PasswordDialog.029}"
                    Click="SkipAllEncrypted_Click" />
            <Button x:Name="SkipPasswordButton" Content="{ui:Text Ui.Xaml.PasswordDialog.030}" IsCancel="True" Click="Skip_Click" />
            <Button x:Name="ContinuePasswordButton" Style="{StaticResource PrimaryButton}" Content="{ui:Text Ui.Xaml.PasswordDialog.031}" IsDefault="True" Click="Continue_Click" Margin="0" />
        </WrapPanel>
    </Grid>
</Window>
