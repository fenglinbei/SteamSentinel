<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>SteamSentinel</AssemblyName>
    <RootNamespace>SteamSentinel.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SteamSentinel.Core\SteamSentinel.Core.csproj" />
    <ProjectReference Include="..\SteamSentinel.Broker\SteamSentinel.Broker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SteamSentinel.ArchiveWorker\SteamSentinel.ArchiveWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyCompanionApplications" AfterTargets="Build">
    <ItemGroup>
      <CompanionFiles Include="..\SteamSentinel.Broker\bin\$(Configuration)\$(TargetFramework)\SteamSentinel.Broker.*" />
      <CompanionFiles Include="..\SteamSentinel.ArchiveWorker\bin\$(Configuration)\$(TargetFramework)\SteamSentinel.ArchiveWorker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CompanionFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
