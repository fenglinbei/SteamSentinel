<Window x:Class="SteamSentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:SteamSentinel.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SteamSentinel.Core.Models;assembly=SteamSentinel.Core"
        Title="{ui:Text Ui.Xaml.MainWindow.001}"
        Icon="/SteamSentinel;component/Assets/App.ico"
        Width="1180" Height="820" MinWidth="800" MinHeight="500"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Grid x:Name="WindowLayout" SizeChanged="WindowLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ActivityPanel" Grid.Row="0" Visibility="Collapsed" Margin="0" Padding="0"
                Background="#F5F8FF" BorderBrush="#DCE7F8" BorderThickness="0,0,0,1"
                AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.006}" AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="18,7,18,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ActivitySpinner" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="ActivityRotation"/></Grid.RenderTransform>
                        <Ellipse Width="18" Height="18" Stroke="#DBEAFE" StrokeThickness="1.8" />
                        <Path Data="M 9,0.9 A 8.1,8.1 0 0 1 16.01,13.05" Stroke="#2563EB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="True">
                        <TextBlock x:Name="ActivityTitleText" DockPanel.Dock="Left" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=ActivityDetailText}" />
                        <TextBlock x:Name="ActivityDetailSeparator" DockPanel.Dock="Left" Text="·" Foreground="#CBD5E1" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ActivityDetailText" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </DockPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border x:Name="ActivityPercentBadge" Visibility="Collapsed" Margin="0,0,8,0" Padding="9,2"
                                CornerRadius="11" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivityPercentText" Visibility="Collapsed"
                                       FontFamily="Segoe UI Variable Display, Consolas, Cascadia Mono, Segoe UI" FontSize="14.5" FontWeight="Bold"
                                       Foreground="#1D4ED8" VerticalAlignment="Center" />
                        </Border>
                        <Border Padding="8,2" CornerRadius="10" Background="#EBF0F7" VerticalAlignment="Center">
                            <TextBlock x:Name="ActivityElapsedText" FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="ActivityProgressBar" Grid.Row="1" Height="3.5" Foreground="#2563EB" Background="#E2E8F0" IsIndeterminate="False" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource ModernTopTabControl}" Margin="0">
            <TabItem Style="{StaticResource ModernTopTabItem}" Header="{ui:Text Ui.Xaml.MainWindow.007}">
                <Grid x:Name="ScanPage" Margin="14,10,14,10" SizeChanged="ScanPage_SizeChanged" LayoutUpdated="ScanPage_LayoutUpdated">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ScanControlsCard" Style="{StaticResource Card}" Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="ScanActionsBar">
                                <Button x:Name="QuickScanButton" Style="{StaticResource PrimaryButton}" Content="{ui:Text Ui.Xaml.MainWindow.008}" Click="QuickScan_Click" />
                                <Button x:Name="FullScanButton" Content="{ui:Text Ui.Xaml.MainWindow.009}" Click="FullScan_Click" />
                                <Button x:Name="FileScanButton" Content="{ui:Text Ui.Xaml.MainWindow.010}" Click="FileScan_Click" />
                                <Button x:Name="FolderScanButton" Content="{ui:Text Ui.Xaml.MainWindow.011}" Click="FolderScan_Click" />
                                <Button x:Name="RetryPasswordsButton" Content="{ui:Text Ui.Xaml.MainWindow.012}" IsEnabled="False" Click="RetryPasswords_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="ScanSettingsButton" Content="{ui:Text Ui.Xaml.MainWindow.013}" Click="ScanSettings_Click" />
                                <Button x:Name="CancelScanButton" Content="{ui:Text Ui.Xaml.MainWindow.014}" IsEnabled="False" Click="CancelScan_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>
                            <StackPanel x:Name="ScanOptionsContainer" Grid.Row="1" Margin="0,6,0,0">
                            <Expander x:Name="ScanOptionsExpander" Header="{ui:Text Ui.Xaml.MainWindow.015}" Expanded="ScanOptions_Expanded">
                            <ScrollViewer x:Name="ScanOptionsScroll" MaxHeight="126" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Keep the final option reachable after fractional-DPI scroll rounding. -->
                            <StackPanel Margin="0,6,0,2">
                            <TextBlock x:Name="ScanScopeText" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,8" Text="{ui:Text Ui.Xaml.MainWindow.016}" />
                            <WrapPanel>
                                <TextBlock Text="{ui:Text Ui.Xaml.MainWindow.018}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <ComboBox x:Name="WorkshopScopeComboBox" AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.019}" DisplayMemberPath="Label" SelectedValuePath="AppId" MinWidth="160" MaxWidth="250" Margin="0,0,18,8" ToolTip="{ui:Text Ui.Xaml.MainWindow.020}" />
                                <CheckBox x:Name="DownloadLocationsCheckBox" Margin="0,0,18,8" Content="{ui:Text Ui.Xaml.MainWindow.021}" ToolTip="{ui:Text Ui.Xaml.MainWindow.022}" Checked="ScopeOptions_Changed" Unchecked="ScopeOptions_Changed" />
                                <CheckBox x:Name="ExecutionHistoryCheckBox" Margin="0,0,18,8" Content="{ui:Text Ui.Xaml.MainWindow.023}" ToolTip="{ui:Text Ui.Xaml.MainWindow.024}" />
                                <CheckBox x:Name="ArchiveCheckBox" IsChecked="True" Margin="0,0,22,6" Content="{ui:Text Ui.Xaml.MainWindow.025}" />
                                <CheckBox x:Name="AmsiCheckBox" IsChecked="False" IsEnabled="True" Visibility="Visible" Margin="0,0,22,6" Content="{ui:Text Ui.Xaml.MainWindow.026}" />
                                <CheckBox x:Name="DeepSignatureCheckBox" IsChecked="True" Margin="0,0,22,6" Content="{ui:Text Ui.Xaml.MainWindow.027}" ToolTip="{ui:Text Ui.Xaml.MainWindow.028}" />
                                <CheckBox x:Name="DomainBlockCheckBox" IsChecked="True" Margin="0,0,18,6" Content="{ui:Text Ui.Xaml.MainWindow.029}" />
                                <!-- 处置模式切换入口已从普通用户界面下线（默认锁定保守模式），保留控件命名与事件以兼容后端策略测试 -->
                                <StackPanel x:Name="RemediationModePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,18,6" VerticalAlignment="Center">
                                    <TextBlock Text="{ui:Text RemediationMode.Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="RemediationModeComboBox" Visibility="Collapsed" Width="126" SelectedIndex="0"
                                              SelectionChanged="RemediationMode_SelectionChanged"
                                              AutomationProperties.Name="{ui:Text RemediationMode.Label}"
                                              ToolTip="{ui:Text RemediationMode.ConservativeDescription}">
                                        <ComboBoxItem Content="{ui:Text RemediationMode.Conservative}" />
                                        <ComboBoxItem Content="{ui:Text RemediationMode.Aggressive}" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="ShowAdvancedTabsCheckBox" IsChecked="False" Margin="0,0,18,6" VerticalAlignment="Center"
                                          Content="{ui:Text Ui.P2C.ShowAdvancedTabs}" ToolTip="{ui:Text Ui.P2C.ShowAdvancedTabsTip}"
                                          Checked="AdvancedTabs_Changed" Unchecked="AdvancedTabs_Changed" />
                            </WrapPanel>
                            </StackPanel>
                            </ScrollViewer>
                            </Expander>
                            </StackPanel>
                            <Border x:Name="InstallationDividerBorder" Grid.Row="2" Margin="0,6,0,0" Padding="0,5,0,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                                <Grid x:Name="InstallationControls">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="InstallationStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="InstallationSecurityText" FontSize="12" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{ui:Text Ui.Xaml.MainWindow.030}" />
                                            <TextBlock x:Name="ElevationHintText" Margin="0,1,0,0" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="ElevateButton" Style="{StaticResource SubtleCompactButton}" Content="{ui:Text Ui.Xaml.MainWindow.031}" IsEnabled="False" Click="Elevate_Click" />
                                        <Button x:Name="RefreshInstallationButton" Style="{StaticResource SubtleCompactButton}" Content="{ui:Text Ui.Xaml.MainWindow.032}" IsEnabled="False" Click="RefreshInstallation_Click" Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="ScanProgressSummary" Grid.Row="1" Margin="0,8,0,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ScanStatusHeader" Grid.Row="0" Grid.ColumnSpan="2" Padding="11,7" Margin="0,0,0,5"
                                CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderStatusText" Foreground="#0F172A" FontSize="13.5" FontWeight="SemiBold"
                                               TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{ui:Text Ui.Xaml.MainWindow.004}" />
                                    <TextBlock x:Name="HeaderDetailText" Margin="0,2,0,0" FontSize="11.5" Foreground="#64748B"
                                               TextAlignment="Left" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{ui:Text Ui.Xaml.MainWindow.005}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="FindingCountText" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" Text="{ui:Text Ui.Xaml.MainWindow.034}" />
                                    <Border x:Name="AggressiveModeBadge" Visibility="Collapsed" Margin="10,0,0,0" Padding="8,2"
                                            CornerRadius="10" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Foreground="#92400E" FontSize="11" FontWeight="SemiBold" Text="{ui:Text Ui.P2C.AggressiveBadge}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DockPanel x:Name="InlineProgressRow" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressStageText" DockPanel.Dock="Left" MaxWidth="460" Margin="0,0,10,0" FontSize="11.5" FontWeight="Medium" Foreground="#334155" Text="{ui:Text Ui.Xaml.MainWindow.033}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="ProgressItemText" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                        <TextBlock x:Name="FindingHandlingSummaryText" Visibility="Collapsed" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="11" Foreground="#64748B"
                                   Text="{ui:Text Ui.Xaml.MainWindow.035}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <ProgressBar x:Name="ScanProgressBar" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,4,0,0" Height="2" Background="#EEF2F6" IsIndeterminate="False" />
                        <Border x:Name="ScanVerdictBanner" Grid.Row="4" Grid.ColumnSpan="2" Visibility="Collapsed"
                                Margin="0,6,0,0" Padding="10,6" CornerRadius="8" BorderThickness="1">
                            <TextBlock x:Name="ScanVerdictText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Border>
                    </Grid>

                    <TabControl Grid.Row="2" x:Name="ResultTabs" Style="{StaticResource ModernSubTabControl}" SelectionChanged="ResultTabs_SelectionChanged">
                    <TabItem Style="{StaticResource ModernSubTabItem}" Header="{ui:Text Ui.Xaml.MainWindow.036}">
                    <Grid x:Name="FindingsAreaHost" SizeChanged="FindingsAreaHost_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PriorityFindingsRow" Height="*" />
                        <RowDefinition x:Name="ReferenceFindingsRow" Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PriorityFindingsEmptyText" Text="{ui:Text FindingPriority.Empty}" Foreground="#667085"
                               Margin="12" TextWrapping="Wrap" Visibility="Collapsed" />
                    <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding PriorityFindings}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionChanged="FindingsGrid_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{ui:Text Ui.Xaml.MainWindow.037}" Width="46" HeaderStyle="{StaticResource GridCenteredHeader}">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="ToolTip" Value="{Binding HandlingDetails}" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" Visibility="{Binding CanSelect, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="{Binding HandlingDetails}" ToolTipService.ShowOnDisabled="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.038}" Binding="{Binding Severity}" IsReadOnly="True" Width="114" ElementStyle="{StaticResource SeverityCellText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.039}" Binding="{Binding Category}" IsReadOnly="True" Width="98" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.041}" Binding="{Binding Title}" IsReadOnly="True" Width="2*" MinWidth="110" ElementStyle="{StaticResource GridPathText}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.042}" Binding="{Binding TargetDisplay}" IsReadOnly="True" Width="2*" MinWidth="120" ElementStyle="{StaticResource GridPathText}" />
                            <DataGridTemplateColumn Header="{ui:Text Ui.Xaml.MainWindow.043}" Width="3*" MinWidth="174" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding HandlingDetails}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HandlingLabel}" Style="{StaticResource HandlingLabelText}" />
                                            <TextBlock Text="{Binding HandlingReasonSummary}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Expander x:Name="ReferenceFindingsExpander" Grid.Row="1" Header="{ui:Text FindingPriority.ReferenceGroup}" IsExpanded="False"
                              Visibility="Collapsed" Background="#F8FAFC" Expanded="ReferenceFindings_ExpansionChanged" Collapsed="ReferenceFindings_ExpansionChanged">
                        <DataGrid x:Name="ReferenceFindingsGrid" ItemsSource="{Binding ReferenceFindings}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionChanged="FindingsGrid_SelectionChanged"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{ui:Text Ui.Xaml.MainWindow.037}" Width="46" HeaderStyle="{StaticResource GridCenteredHeader}">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="ToolTip" Value="{Binding HandlingDetails}" />
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}" Visibility="{Binding CanSelect, Converter={StaticResource BoolToVis}}"
                                                      ToolTip="{Binding HandlingDetails}" ToolTipService.ShowOnDisabled="True" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.041}" Binding="{Binding Title}" IsReadOnly="True" Width="*" MinWidth="120" ElementStyle="{StaticResource GridPathText}" />
                                <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.042}" Binding="{Binding TargetDisplay}" IsReadOnly="True" Width="2*" MinWidth="140" ElementStyle="{StaticResource GridPathText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                    <Border x:Name="ScanStageOverlay" Grid.Row="0" Panel.ZIndex="10" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.44" RadiusX="0.7" RadiusY="0.78">
                                <GradientStop Color="#FFF5F9FF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.65" />
                                <GradientStop Color="#FFF8FAFC" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <StackPanel MaxWidth="460" Margin="20,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="ScanStageRingHost" Width="108" Height="108" HorizontalAlignment="Center">
                                <Ellipse x:Name="ScanPulseRing1" Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#3B82F6" StrokeThickness="1.3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="ScanPulseScale1" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="ScanPulseRing2" Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#3B82F6" StrokeThickness="1.3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="ScanPulseScale2" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#E6EEF9" StrokeThickness="5.5" />
                                <Grid x:Name="ScanRingIndeterminateHost" Width="108" Height="108" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="ScanRingIndeterminateRotation" Angle="0" />
                                    </Grid.RenderTransform>
                                    <Path StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 54,12 A 42,42 0 0 1 93.47,68.36">
                                        <Path.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3B82F6" Offset="0" />
                                                <GradientStop Color="#2563EB" Offset="0.5" />
                                                <GradientStop Color="#4F46E5" Offset="1" />
                                            </LinearGradientBrush>
                                        </Path.Stroke>
                                    </Path>
                                </Grid>
                                <Path x:Name="ScanRingProgressPath" Visibility="Collapsed" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0" />
                                            <GradientStop Color="#2563EB" Offset="0.5" />
                                            <GradientStop Color="#4F46E5" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="54,12" IsClosed="False">
                                                <ArcSegment x:Name="ScanRingArcSegment" Size="42,42" SweepDirection="Clockwise" Point="54.5,12" IsLargeArc="False" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <Grid x:Name="ScanRingHeadDotHost" Width="108" Height="108" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="ScanRingHeadRotation" Angle="0" />
                                    </Grid.RenderTransform>
                                    <Grid Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                                        <Ellipse Width="12" Height="12" Fill="#4D3B82F6" />
                                        <Ellipse Width="7" Height="7" Fill="#FFFFFF" Stroke="#2563EB" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                                <StackPanel x:Name="ScanStagePercentPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="ScanStagePercentNumber" FontFamily="Segoe UI Variable Display, Consolas, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Text="0" />
                                    <TextBlock x:Name="ScanStagePercentSymbol" Text="%" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Bottom" Margin="1,0,0,5" />
                                </StackPanel>
