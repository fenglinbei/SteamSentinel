<Window x:Class="SteamSentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SteamSentinel.Core.Models;assembly=SteamSentinel.Core"
        Title="SteamSentinel Steam 红信安全工具"
        Icon="/SteamSentinel;component/Assets/App.ico"
        Width="1180" Height="820" MinWidth="800" MinHeight="500"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">
    <Grid x:Name="WindowLayout" SizeChanged="WindowLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderCard" Background="#101828" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/SteamSentinel;component/Assets/App.png" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="SteamSentinel 图标" />
                    <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="SteamSentinel" />
                        <Border Margin="10,0,0,0" Background="#B42318" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Text="{x:Static models:ProductInfo.Version}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ProductTagline" Margin="0,2,0,0" Foreground="#D0D5DD" FontSize="11" Text="Steam 工坊 · MOD · 插件安全检查" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatusText" Foreground="White" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="尚未扫描" />
                    <TextBlock x:Name="HeaderDetailText" Margin="0,3,0,0" Foreground="#D0D5DD" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="规则载入中" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ActivityPanel" Grid.Row="1" Visibility="Collapsed" Margin="12,6,12,0" Padding="10,6"
                Background="#EFF6FF" BorderBrush="#B2CCFF" BorderThickness="1" CornerRadius="8"
                AutomationProperties.Name="当前操作状态" AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ActivitySpinner" Width="26" Height="26" Margin="0,0,12,0" Grid.RowSpan="2" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform x:Name="ActivityRotation"/></Grid.RenderTransform>
                    <Ellipse Width="22" Height="22" Stroke="#D1E0FF" StrokeThickness="3"/>
                    <Path Data="M13,2 A11,11 0 0 1 24,13" Stroke="#175CD3" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
                <TextBlock x:Name="ActivityTitleText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="#1849A9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=ActivityDetailText}"/>
                <TextBlock x:Name="ActivityElapsedText" Grid.Column="2" Margin="12,0,0,0" Foreground="#475467" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActivityDetailText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0" Foreground="#475467" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <ProgressBar x:Name="ActivityProgressBar" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,5,0,0" Height="3" Foreground="#175CD3" Background="#D1E0FF" IsIndeterminate="False"/>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="12,8,12,8">
            <TabItem Header="扫描与处置">
                <Grid x:Name="ScanPage" Margin="10" SizeChanged="ScanPage_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ScanControlsCard" Style="{StaticResource Card}" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="ScanActionsBar">
                                <Button x:Name="QuickScanButton" Style="{StaticResource PrimaryButton}" Content="快速扫描" Click="QuickScan_Click" />
                                <Button x:Name="FullScanButton" Content="完整内容扫描" Click="FullScan_Click" />
                                <Button x:Name="FileScanButton" Content="扫描文件" Click="FileScan_Click" />
                                <Button x:Name="FolderScanButton" Content="扫描目录" Click="FolderScan_Click" />
                                <Button x:Name="RetryPasswordsButton" Content="重试未解密内容" IsEnabled="False" Click="RetryPasswords_Click" />
                                <Button x:Name="ScanSettingsButton" Content="扫描限制设置" Click="ScanSettings_Click" />
                                <Button x:Name="CancelScanButton" Content="取消" IsEnabled="False" Click="CancelScan_Click" />
                            </WrapPanel>
                            <StackPanel x:Name="ScanOptionsContainer" Grid.Row="1" Margin="0,5,0,0">
                            <Expander x:Name="ScanOptionsExpander" Header="扫描范围与选项 · 仅所选范围，不是全盘检查" Expanded="ScanOptions_Expanded">
                            <ScrollViewer x:Name="ScanOptionsScroll" MaxHeight="126" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,6,0,0">
                            <TextBlock x:Name="ScanScopeText" TextWrapping="Wrap" Foreground="#475467" Margin="0,0,0,6" Text="快速扫描：Steam 运行状态与本地工坊、MOD、插件；视频先查结构和尾随内容，不是全盘扫描。" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="快速扫描优先检查关联落点和启动型内容。大小、深度、读取量、时间与临时磁盘等预算可在“扫描限制设置”调整，快速与完整／自选模式分别保存。报告记录本轮实际设置及未完成原因。完整内容扫描只检查所选范围，不是全盘查杀。" />
                            <WrapPanel>
                                <TextBlock Text="工坊范围" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <ComboBox x:Name="WorkshopScopeComboBox" AutomationProperties.Name="工坊扫描范围" DisplayMemberPath="Label" SelectedValuePath="AppId" MinWidth="160" MaxWidth="250" Margin="0,0,18,8" ToolTip="只限制工坊内容，Steam 客户端、插件和关联启动项仍会检查。" />
                                <CheckBox x:Name="DownloadLocationsCheckBox" Margin="0,0,18,8" Content="额外检查下载、桌面和临时目录" ToolTip="会递归检查其中的资料、样本和开发目录，明显增加扫描时间。文件存在不代表已感染。" Checked="ScopeOptions_Changed" Unchecked="ScopeOptions_Changed" />
                                <CheckBox x:Name="ExecutionHistoryCheckBox" Margin="0,0,18,8" Content="检查可疑运行历史" ToolTip="默认关闭，只输出可疑执行链提示，不导出完整运行命令。" />
                                <CheckBox x:Name="ArchiveCheckBox" IsChecked="True" Margin="0,0,22,0" Content="递归检查压缩包" />
                                <CheckBox x:Name="AmsiCheckBox" IsChecked="True" Margin="0,0,22,0" Content="使用本机反恶意软件接口（AMSI）辅助扫描" />
                                <CheckBox x:Name="DeepSignatureCheckBox" IsChecked="True" Margin="0,0,22,0" Content="离线核验内容签名" ToolTip="仅按本地可用信任信息核验文件签名；签名与恶意性分别记录。" />
                                <CheckBox x:Name="DomainBlockCheckBox" IsChecked="True" Content="处置时阻断已知恶意域名" />
                            </WrapPanel>
                            </StackPanel>
                            </ScrollViewer>
                            </Expander>
                            </StackPanel>
                            <Grid x:Name="InstallationControls" Grid.Row="2" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="InstallationSecurityText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="正在检查安装环境…" />
                                    <TextBlock x:Name="ElevationHintText" Margin="0,2,0,0" FontSize="11" Foreground="#475467" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ElevateButton" Content="打开管理员窗口" IsEnabled="False" Click="Elevate_Click" />
                                    <Button x:Name="RefreshInstallationButton" Content="重新检查" IsEnabled="False" Click="RefreshInstallation_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid x:Name="ScanProgressSummary" Grid.Row="1" Margin="0,7,0,7">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressStageText" DockPanel.Dock="Left" MaxWidth="200" Margin="0,0,10,0" FontWeight="SemiBold" Text="等待扫描" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="ProgressItemText" Foreground="#667085" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                        <ProgressBar x:Name="ScanProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Height="3" IsIndeterminate="False" />
                        <TextBlock x:Name="FindingCountText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="0 项发现" />
                        <TextBlock x:Name="FindingHandlingSummaryText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="11" Foreground="#475467"
                                   Text="尚无处理资格统计" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>

                    <TabControl Grid.Row="2" x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
                    <TabItem Header="风险与提示">
                    <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding Findings}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionChanged="FindingsGrid_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="处置" Width="46" HeaderStyle="{StaticResource GridCenteredHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" ToolTip="{Binding HandlingDetails}" ToolTipService.ShowOnDisabled="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="严重度" Binding="{Binding Severity}" IsReadOnly="True" Width="72" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" IsReadOnly="True" Width="64" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="分数" Binding="{Binding Score}" IsReadOnly="True" Width="48" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="发现" Binding="{Binding Title}" IsReadOnly="True" Width="2*" MinWidth="110" ElementStyle="{StaticResource GridPathText}" />
                            <DataGridTextColumn Header="目标" Binding="{Binding Target}" IsReadOnly="True" Width="2*" MinWidth="120" ElementStyle="{StaticResource GridPathText}" />
                            <DataGridTemplateColumn Header="处理状态与原因" Width="3*" MinWidth="174" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding HandlingDetails}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HandlingLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding HandlingReason}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </TabItem>
                    <TabItem x:Name="CoverageTab" Header="未检查内容">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="CoverageStatusText" Text="尚无扫描结果。这里显示未检查或未完成检查的原因，不计入风险数量。" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6" />
                            <DataGrid x:Name="CoverageGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="CoverageGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="原因" Binding="{Binding Kind}" Width="2*" MinWidth="160" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="记录数" Binding="{Binding Count}" Width="65" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                                    <DataGridTextColumn Header="下一步" Binding="{Binding NextStep}" Width="3*" MinWidth="200" ElementStyle="{StaticResource GridCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="BatchResultsTab" Header="处置结果">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="BatchSummaryText" Text="尚未生成处置方案，这里会逐项列出已选目标的处理结果。" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="BatchFollowUpText" Text="原扫描范围复查与系统复查会分开显示，动作成功不代表全部威胁已清除。" TextTrimming="CharacterEllipsis" MaxHeight="18" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6"/>
                            </StackPanel>
                            <DataGrid x:Name="BatchResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="95" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*" MinWidth="160">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="结果与原因" Binding="{Binding Reason}" Width="*" MinWidth="180">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="TrustProxyTab" Header="代理与证书">
                        <Grid x:Name="TrustProxyPage" Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TrustProxyStatusText" Text="尚未检查代理与证书" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Button x:Name="TrustProxyScanButton" Grid.Column="1" Content="检查代理与证书" Click="TrustProxyScan_Click" Margin="0"
                                        ToolTip="只读检查本机代理配置与证书；不连接外部地址，不修改配置。无需管理员权限。" ToolTipService.ShowOnDisabled="True" />
                            </Grid>
                            <TextBlock x:Name="TrustProxyScopeText" Grid.Row="1" Margin="0,5,0,6" FontSize="11" Foreground="#475467" Text="仅采集本地配置与证书，不下载 PAC、不访问目标地址；读取完整不代表配置安全。"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBox x:Name="TrustProxyDetailsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D5DD" Background="White"
                                     AutomationProperties.Name="代理与证书诊断记录，只读"
                                     Text="点击“检查代理与证书”后，这里会列出每项采集状态、代理配置来源、证书存储区及证书摘要。已有扫描发现会保留。" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="RelatedComponentsTab" Header="组件关联">
                        <Grid x:Name="RelatedComponentsPage" Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="RelatedComponentsStatusText" Text="尚无组件关联记录" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="RelatedComponentsScopeText" Grid.Row="1" Margin="0,5,0,6" FontSize="11" Foreground="#475467"
                                       Text="仅记录路径关系；磁盘文件核验不代表进程内存内容，写入者仍未定位。"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBox x:Name="RelatedComponentsDetailsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D5DD" Background="White"
                                     AutomationProperties.Name="组件关联检查记录，只读"
                                     Text="正常扫描完成关联检查后，这里显示来源、宿主身份、候选原因、受限内容检查与各轮预算。关联记录不会自行生成处理权限。" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="CasesTab" Header="病例复验">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CaseListComboBox" MinWidth="80" Margin="0,0,6,0" VerticalContentAlignment="Center" ToolTip="已保存的本账户病例；选择后可只读复验。"/>
                                <Button x:Name="CaseRefreshButton" Grid.Column="1" Content="读取病例" Click="CaseRefresh_Click" Margin="0,0,6,0"/>
                                <Button x:Name="CaseRecheckButton" Grid.Column="2" Content="复验所选病例" Click="CaseRecheck_Click" Margin="0"/>
                                <Button x:Name="CaseExportButton" Grid.Column="3" Content="导出病例" Click="CaseExport_Click" Margin="6,0,0,0"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Margin="0,5,0,6" FontSize="11" Foreground="#475467" Text="重启或重新登录后，重新打开程序并复验；不会重放旧计划或自动重启。" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBox x:Name="CaseDetailsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D5DD" Background="White"
                                     AutomationProperties.Name="病例跨会话复验记录，只读" Text="尚无已保存病例。确认处置后会在本账户保存计划、执行结果和处置前会话身份。"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ContainerTab" Header="容器检查">
                        <Grid x:Name="ContainerPage" Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ContainerStatusText" Text="尚无容器递归检查记录" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <WrapPanel x:Name="ContainerActionsBar" Grid.Row="1" Margin="0,5,0,4">
                                <Button x:Name="ContainerRecheckButton" Content="补查原始外层/卷组" Click="ContainerRecheck_Click" IsEnabled="False" Margin="0,0,6,3"
                                        ToolTip="重新扫描所选节点所属原始文件或卷组，生成新报告；不扫描已删除的临时成员，不写出恢复内容。"/>
                                <Button x:Name="ContainerSupplementButton" Content="选择补卷目录后补查" Click="ContainerSupplement_Click" IsEnabled="False" Margin="0,0,6,3"
                                        ToolTip="仅在你明确选择的本地目录中寻找补充分卷，然后重新检查原始卷组。"/>
                                <Button x:Name="ContainerRecoveryButton" Content="选择恢复目录并重扫" Click="ContainerRecovery_Click" IsEnabled="False" Margin="0,0,6,3"
                                        ToolTip="明确选择独立目录后，重新扫描并请求写出可恢复内容；不会启动或执行输出。普通导出报告不包含这些内容。"/>
                                <Button x:Name="ContainerFullDetailsButton" Content="完整记录" Click="ContainerFullDetails_Click" IsEnabled="False" Margin="0,0,6,3"/>
                                <Button x:Name="ContainerExportButton" Content="导出报告" Click="Export_Click" IsEnabled="False" Margin="0,0,0,3"/>
                            </WrapPanel>
                            <ComboBox x:Name="ContainerNodesComboBox" Grid.Row="2" Margin="0,0,0,5" MinWidth="80"
                                      SelectionChanged="ContainerNodes_SelectionChanged" IsEnabled="False"
                                      AutomationProperties.Name="选择容器节点与阶段链" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox x:Name="ContainerDetailsText" Grid.Row="3" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D5DD" Background="White"
                                     AutomationProperties.Name="容器层级、完整路径、五阶段与预算记录，只读可复制"
                                     Text="扫描文件或目录后，这里显示每层容器关系、完整性、内容检测和预算。可选择文本并按 Ctrl+C 复制。"/>
                        </Grid>
                    </TabItem>
                    </TabControl>

                    <Expander x:Name="FindingDetailCard" Grid.Row="3" Header="所选项详情 · 完整路径与证据" IsExpanded="True" Margin="0,7,0,0" Background="White" Expanded="FindingDetails_Expanded">
                        <ScrollViewer x:Name="FindingDetailScroll" Height="100" Margin="8,5,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="意味着什么" />
                                <TextBlock x:Name="DetailDescriptionText" Grid.Column="1" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Margin="0,7,0,0" FontWeight="SemiBold" Text="证据" />
                                <TextBlock x:Name="DetailEvidenceText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Margin="0,7,0,0" FontWeight="SemiBold" Text="SHA-256" />
                                <TextBlock x:Name="DetailHashText" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Margin="0,7,0,0" FontWeight="SemiBold" Text="工坊 ID" />
                                <TextBlock x:Name="DetailWorkshopText" Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </ScrollViewer>
                    </Expander>

                    <DockPanel x:Name="SelectionActionsBar" Grid.Row="4" Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="RemediateButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"
                                IsEnabled="False" Content="预览并处置所选项" Click="Remediate_Click" ToolTipService.ShowOnDisabled="True">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button x:Name="CoverSelectedButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Content="补查所选内容" ToolTip="对所选文件或目录进行完整内容扫描；密码、权限、格式或安全限制仍可能导致部分内容无法检查。" IsEnabled="False" Click="CoverSelected_Click">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button x:Name="FollowUpDetailsButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Content="查看完整复查说明" Click="FollowUpDetails_Click">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <WrapPanel>
                            <Button x:Name="ExportButton" Content="导出报告" IsEnabled="False" Click="Export_Click" />
                            <WrapPanel>
                            <WrapPanel.Style><Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></WrapPanel.Style>
                            <Button x:Name="SelectAllButton" Content="全选可处置项" Click="SelectAll_Click" ToolTipService.ShowOnDisabled="True" />
                            <Button x:Name="ClearSelectionButton" Content="清除选择" Click="ClearSelection_Click" />
                            <Button x:Name="ReviewFindingButton" Content="进一步检查" IsEnabled="False" Click="ReviewFinding_Click" ToolTip="检查当前选中项的实际文件和关联启动入口，不执行文件，也不会自动隔离。" ToolTipService.ShowOnDisabled="True" />
                            <Button x:Name="OccupancyButton" Content="查看占用" IsEnabled="False" Click="Occupancy_Click" ToolTip="只读查询谁正在使用所选文件，不关闭程序或句柄。" />
                            </WrapPanel>
                        </WrapPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="隔离与回滚">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <TextBlock TextWrapping="Wrap" Text="隔离记录由管理员组件核对后才能回滚。当前版本保留仍有活动记录的隔离事件，不提供永久删除；已全部回滚的空事件，需在重启及完整复扫无已知威胁后才能清理。旧版缺少可信索引的事件请保留隔离并人工核对。" />
                    </Border>
                    <DataGrid x:Name="QuarantineGrid" Grid.Row="1" Margin="0,12,0,12" ItemsSource="{Binding QuarantineItems}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="事件 ID" Binding="{Binding IncidentId}" Width="2*" MinWidth="140" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding Created}" Width="156" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="记录数" Binding="{Binding ItemCount}" Width="62" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" MinWidth="120" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridCheckBoxColumn Header="已重启" Binding="{Binding RebootObserved, Mode=OneWay}" Width="62" ElementStyle="{StaticResource GridReadOnlyCheckBox}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2">
                        <Button Content="刷新" Click="RefreshQuarantine_Click" />
                        <Button Content="打开隔离目录" Click="OpenQuarantine_Click" />
                        <Button x:Name="RollbackButton" IsEnabled="False" Content="回滚所选事件" Click="Rollback_Click" />
                        <Button x:Name="DeleteIncidentButton" IsEnabled="False" Style="{StaticResource PrimaryButton}" Content="永久删除所选事件" Click="DeleteIncident_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="边界与安全">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="本工具能做什么，不能做什么" />
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="本程序不会运行被扫描的媒体、脚本或可执行文件。压缩内容会在 Low Integrity 受限令牌的独立工作进程中读取，进程先加入单进程 Job Object，再接收扫描路径，并在主程序退出时终止。普通扫描不会请求管理员权限。" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="只有安装环境与组件完整性检查通过后，才能请求管理员授权。处置时可自动请求 UAC，也可点击“打开管理员窗口”后重新扫描，原窗口与报告会保留。标准账户需提供管理员凭据，工具不会收集密码。管理员处置组件仍会核对请求者、计划 SHA-256、精确路径、文件哈希或目录指纹。" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="本程序聚焦 Steam、Wallpaper Engine 与已观察到的假红信链路，可完成一次快速扫描、辨别、隔离和 Steam 恢复。“完整扫描，未发现已知威胁”仍不代表电脑绝对安全。加密内容未解开、格式不受支持、缺少分卷或触发资源限制时，报告会标记为“未完整扫描”。" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22" FontWeight="SemiBold" Foreground="#B42318"
                                   Text="启发式发现会继续保留处置能力，但默认不预选。即使处置显示成功，也只代表本次计划中的目标已处理，不代表整台电脑已经无毒。条件允许时，仍建议再用保持更新的专业杀毒软件进行全盘复核。" />
                        <TextBlock Margin="0,22,0,0" FontSize="18" FontWeight="SemiBold" Text="开源与许可" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="本工具由 fenglinbei 开源，采用 Apache License 2.0。你可以查看源码，并按许可证约定使用、修改和分享。完整条款见安装目录中的 LICENSE，版权及第三方声明见 NOTICE 和 THIRD-PARTY-NOTICES.md。" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="开源页面：https://github.com/fenglinbei/SteamSentinel" />
                        <TextBlock Margin="0,8,0,0" Foreground="#667085" Text="Copyright © 2026 fenglinbei" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#E4E7EC" Padding="12,4">
            <TextBlock x:Name="FooterText" Foreground="#475467" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="本地运行 · 默认不上传样本或账户数据 · 隔离可回滚" />
        </Border>
    </Grid>
</Window>
