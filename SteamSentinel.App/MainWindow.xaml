<Window x:Class="SteamSentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:SteamSentinel.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SteamSentinel.Core.Models;assembly=SteamSentinel.Core"
        Title="{ui:Text Ui.Xaml.MainWindow.001}"
        Icon="/SteamSentinel;component/Assets/App.ico"
        Width="1180" Height="820" MinWidth="800" MinHeight="500"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">
    <Grid x:Name="WindowLayout" SizeChanged="WindowLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderCard" Background="#101828" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/SteamSentinel;component/Assets/App.png" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.002}" />
                    <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="SteamSentinel" />
                        <Border Margin="10,0,0,0" Background="#B42318" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Text="{x:Static models:ProductInfo.Version}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ProductTagline" Margin="0,2,0,0" Foreground="#D0D5DD" FontSize="11" Text="{ui:Text Ui.Xaml.MainWindow.003}" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatusText" Foreground="White" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{ui:Text Ui.Xaml.MainWindow.004}" />
                    <TextBlock x:Name="HeaderDetailText" Margin="0,3,0,0" Foreground="#D0D5DD" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{ui:Text Ui.Xaml.MainWindow.005}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ActivityPanel" Grid.Row="1" Visibility="Collapsed" Margin="12,6,12,0" Padding="10,6"
                Background="#EFF6FF" BorderBrush="#B2CCFF" BorderThickness="1" CornerRadius="8"
                AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.006}" AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ActivitySpinner" Width="26" Height="26" Margin="0,0,12,0" Grid.RowSpan="2" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform x:Name="ActivityRotation"/></Grid.RenderTransform>
                    <Ellipse Width="22" Height="22" Stroke="#D1E0FF" StrokeThickness="3"/>
                    <Path Data="M13,2 A11,11 0 0 1 24,13" Stroke="#175CD3" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
                <TextBlock x:Name="ActivityTitleText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="#1849A9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=ActivityDetailText}"/>
                <TextBlock x:Name="ActivityElapsedText" Grid.Column="2" Margin="12,0,0,0" Foreground="#475467" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActivityDetailText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0" Foreground="#475467" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <ProgressBar x:Name="ActivityProgressBar" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,5,0,0" Height="3" Foreground="#175CD3" Background="#D1E0FF" IsIndeterminate="False"/>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="12,8,12,8">
            <TabItem Header="{ui:Text Ui.Xaml.MainWindow.007}">
                <Grid x:Name="ScanPage" Margin="10" SizeChanged="ScanPage_SizeChanged" LayoutUpdated="ScanPage_LayoutUpdated">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ScanControlsCard" Style="{StaticResource Card}" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="ScanActionsBar">
                                <Button x:Name="QuickScanButton" Style="{StaticResource PrimaryButton}" Content="{ui:Text Ui.Xaml.MainWindow.008}" Click="QuickScan_Click" />
                                <Button x:Name="FullScanButton" Content="{ui:Text Ui.Xaml.MainWindow.009}" Click="FullScan_Click" />
                                <Button x:Name="FileScanButton" Content="{ui:Text Ui.Xaml.MainWindow.010}" Click="FileScan_Click" />
                                <Button x:Name="FolderScanButton" Content="{ui:Text Ui.Xaml.MainWindow.011}" Click="FolderScan_Click" />
                                <Button x:Name="RetryPasswordsButton" Content="{ui:Text Ui.Xaml.MainWindow.012}" IsEnabled="False" Click="RetryPasswords_Click" />
                                <Button x:Name="ScanSettingsButton" Content="{ui:Text Ui.Xaml.MainWindow.013}" Click="ScanSettings_Click" />
                                <Button x:Name="CancelScanButton" Content="{ui:Text Ui.Xaml.MainWindow.014}" IsEnabled="False" Click="CancelScan_Click" />
                            </WrapPanel>
                            <StackPanel x:Name="ScanOptionsContainer" Grid.Row="1" Margin="0,5,0,0">
                            <Expander x:Name="ScanOptionsExpander" Header="{ui:Text Ui.Xaml.MainWindow.015}" Expanded="ScanOptions_Expanded">
                            <ScrollViewer x:Name="ScanOptionsScroll" MaxHeight="126" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Keep the final option reachable after fractional-DPI scroll rounding. -->
                            <StackPanel Margin="0,6,0,2">
                            <TextBlock x:Name="ScanScopeText" TextWrapping="Wrap" Foreground="#475467" Margin="0,0,0,6" Text="{ui:Text Ui.Xaml.MainWindow.016}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{ui:Text Ui.Xaml.MainWindow.017}" />
                            <WrapPanel>
                                <TextBlock Text="{ui:Text Ui.Xaml.MainWindow.018}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <ComboBox x:Name="WorkshopScopeComboBox" AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.019}" DisplayMemberPath="Label" SelectedValuePath="AppId" MinWidth="160" MaxWidth="250" Margin="0,0,18,8" ToolTip="{ui:Text Ui.Xaml.MainWindow.020}" />
                                <CheckBox x:Name="DownloadLocationsCheckBox" Margin="0,0,18,8" Content="{ui:Text Ui.Xaml.MainWindow.021}" ToolTip="{ui:Text Ui.Xaml.MainWindow.022}" Checked="ScopeOptions_Changed" Unchecked="ScopeOptions_Changed" />
                                <CheckBox x:Name="ExecutionHistoryCheckBox" Margin="0,0,18,8" Content="{ui:Text Ui.Xaml.MainWindow.023}" ToolTip="{ui:Text Ui.Xaml.MainWindow.024}" />
                                <CheckBox x:Name="ArchiveCheckBox" IsChecked="True" Margin="0,0,22,0" Content="{ui:Text Ui.Xaml.MainWindow.025}" />
                                <CheckBox x:Name="AmsiCheckBox" IsChecked="False" IsEnabled="False" Visibility="Collapsed" Margin="0,0,22,0" Content="{ui:Text Ui.Xaml.MainWindow.026}" />
                                <CheckBox x:Name="DeepSignatureCheckBox" IsChecked="True" Margin="0,0,22,0" Content="{ui:Text Ui.Xaml.MainWindow.027}" ToolTip="{ui:Text Ui.Xaml.MainWindow.028}" />
                                <CheckBox x:Name="DomainBlockCheckBox" IsChecked="True" Content="{ui:Text Ui.Xaml.MainWindow.029}" />
                            </WrapPanel>
                            </StackPanel>
                            </ScrollViewer>
                            </Expander>
                            </StackPanel>
                            <Grid x:Name="InstallationControls" Grid.Row="2" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="InstallationSecurityText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{ui:Text Ui.Xaml.MainWindow.030}" />
                                    <TextBlock x:Name="ElevationHintText" Margin="0,2,0,0" FontSize="11" Foreground="#475467" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ElevateButton" Content="{ui:Text Ui.Xaml.MainWindow.031}" IsEnabled="False" Click="Elevate_Click" />
                                    <Button x:Name="RefreshInstallationButton" Content="{ui:Text Ui.Xaml.MainWindow.032}" IsEnabled="False" Click="RefreshInstallation_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid x:Name="ScanProgressSummary" Grid.Row="1" Margin="0,7,0,7">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressStageText" DockPanel.Dock="Left" MaxWidth="200" Margin="0,0,10,0" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.MainWindow.033}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="ProgressItemText" Foreground="#667085" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                        <ProgressBar x:Name="ScanProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,1,0,0" Height="3" IsIndeterminate="False" />
                        <TextBlock x:Name="FindingCountText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.MainWindow.034}" />
                        <TextBlock x:Name="FindingHandlingSummaryText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="11" Foreground="#475467"
                                   Text="{ui:Text Ui.Xaml.MainWindow.035}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>

                    <TabControl Grid.Row="2" x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
                    <TabItem Header="{ui:Text Ui.Xaml.MainWindow.036}">
                    <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding Findings}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionChanged="FindingsGrid_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{ui:Text Ui.Xaml.MainWindow.037}" Width="46" HeaderStyle="{StaticResource GridCenteredHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" ToolTip="{Binding HandlingDetails}" ToolTipService.ShowOnDisabled="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.038}" Binding="{Binding Severity}" IsReadOnly="True" Width="72" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.039}" Binding="{Binding Category}" IsReadOnly="True" Width="64" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.040}" Binding="{Binding Score}" IsReadOnly="True" Width="48" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.041}" Binding="{Binding Title}" IsReadOnly="True" Width="2*" MinWidth="110" ElementStyle="{StaticResource GridPathText}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.042}" Binding="{Binding TargetDisplay}" IsReadOnly="True" Width="2*" MinWidth="120" ElementStyle="{StaticResource GridPathText}" />
                            <DataGridTemplateColumn Header="{ui:Text Ui.Xaml.MainWindow.043}" Width="3*" MinWidth="174" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding HandlingDetails}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HandlingLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding HandlingReason}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </TabItem>
                    <TabItem x:Name="CoverageTab" Header="{ui:Text Ui.Xaml.MainWindow.044}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="CoverageStatusText" Text="{ui:Text Ui.Xaml.MainWindow.045}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6" />
                            <DataGrid x:Name="CoverageGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="CoverageGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.046}" Binding="{Binding Kind}" Width="2*" MinWidth="160" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.047}" Binding="{Binding Count}" Width="65" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                                    <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.048}" Binding="{Binding NextStep}" Width="3*" MinWidth="200" ElementStyle="{StaticResource GridCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="BatchResultsTab" Header="{ui:Text Ui.Xaml.MainWindow.049}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="BatchSummaryText" Text="{ui:Text Ui.Xaml.MainWindow.050}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="BatchFollowUpText" Text="{ui:Text Ui.Xaml.MainWindow.051}" TextTrimming="CharacterEllipsis" MaxHeight="18" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6"/>
                            </StackPanel>
                            <DataGrid x:Name="BatchResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.052}" Binding="{Binding Status}" Width="95" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.053}" Binding="{Binding Target}" Width="*" MinWidth="160">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.054}" Binding="{Binding Reason}" Width="*" MinWidth="180">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}"/></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="TrustProxyTab" Header="{ui:Text Ui.Xaml.MainWindow.055}">
                        <Grid x:Name="TrustProxyPage" Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TrustProxyStatusText" Text="{ui:Text Ui.Xaml.MainWindow.056}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Button x:Name="TrustProxyScanButton" Grid.Column="1" Content="{ui:Text Ui.Xaml.MainWindow.057}" Click="TrustProxyScan_Click" Margin="0"
                                        ToolTip="{ui:Text Ui.Xaml.MainWindow.058}" ToolTipService.ShowOnDisabled="True" />
                            </Grid>
                            <TextBlock x:Name="TrustProxyScopeText" Grid.Row="1" Margin="0,5,0,6" FontSize="11" Foreground="#475467" Text="{ui:Text Ui.Xaml.MainWindow.059}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBox x:Name="TrustProxyDetailsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D5DD" Background="White"
                                     AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.060}"
                                     Text="{ui:Text Ui.Xaml.MainWindow.061}" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="RelatedComponentsTab" Header="{ui:Text Ui.Xaml.MainWindow.062}">
                        <Grid x:Name="RelatedComponentsPage" Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="RelatedComponentsStatusText" Text="{ui:Text Ui.Xaml.MainWindow.063}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="RelatedComponentsScopeText" Grid.Row="1" Margin="0,5,0,6" FontSize="11" Foreground="#475467"
                                       Text="{ui:Text Ui.Xaml.MainWindow.064}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBox x:Name="RelatedComponentsDetailsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D5DD" Background="White"
                                     AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.065}"
                                     Text="{ui:Text Ui.Xaml.MainWindow.066}" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="CasesTab" Header="{ui:Text Ui.Xaml.MainWindow.067}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CaseListComboBox" MinWidth="80" Margin="0,0,6,0" VerticalContentAlignment="Center" ToolTip="{ui:Text Ui.Xaml.MainWindow.068}"/>
                                <Button x:Name="CaseRefreshButton" Grid.Column="1" Content="{ui:Text Ui.Xaml.MainWindow.069}" Click="CaseRefresh_Click" Margin="0,0,6,0"/>
                                <Button x:Name="CaseRecheckButton" Grid.Column="2" Content="{ui:Text Ui.Xaml.MainWindow.070}" Click="CaseRecheck_Click" Margin="0"/>
                                <Button x:Name="CaseExportButton" Grid.Column="3" Content="{ui:Text Ui.Xaml.MainWindow.071}" Click="CaseExport_Click" Margin="6,0,0,0"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Margin="0,5,0,6" FontSize="11" Foreground="#475467" Text="{ui:Text Ui.Xaml.MainWindow.072}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBox x:Name="CaseDetailsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D5DD" Background="White"
                                     AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.073}" Text="{ui:Text Ui.Xaml.MainWindow.074}"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ContainerTab" Header="{ui:Text Ui.Xaml.MainWindow.075}">
                        <Grid x:Name="ContainerPage" Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ContainerStatusText" Text="{ui:Text Ui.Xaml.MainWindow.076}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <WrapPanel x:Name="ContainerActionsBar" Grid.Row="1" Margin="0,5,0,4">
                                <Button x:Name="ContainerRecheckButton" Content="{ui:Text Ui.Xaml.MainWindow.077}" Click="ContainerRecheck_Click" IsEnabled="False" Margin="0,0,6,3"
                                        ToolTip="{ui:Text Ui.Xaml.MainWindow.078}"/>
                                <Button x:Name="ContainerSupplementButton" Content="{ui:Text Ui.Xaml.MainWindow.079}" Click="ContainerSupplement_Click" IsEnabled="False" Margin="0,0,6,3"
                                        ToolTip="{ui:Text Ui.Xaml.MainWindow.080}"/>
                                <Button x:Name="ContainerRecoveryButton" Content="{ui:Text Ui.Xaml.MainWindow.081}" Click="ContainerRecovery_Click" IsEnabled="False" Margin="0,0,6,3"
                                        ToolTip="{ui:Text Ui.Xaml.MainWindow.082}"/>
                                <Button x:Name="ContainerFullDetailsButton" Content="{ui:Text Ui.Xaml.MainWindow.083}" Click="ContainerFullDetails_Click" IsEnabled="False" Margin="0,0,6,3"/>
                                <Button x:Name="ContainerExportButton" Content="{ui:Text Ui.Xaml.MainWindow.084}" Click="Export_Click" IsEnabled="False" Margin="0,0,0,3"/>
                            </WrapPanel>
                            <ComboBox x:Name="ContainerNodesComboBox" Grid.Row="2" Margin="0,0,0,5" MinWidth="80"
                                      SelectionChanged="ContainerNodes_SelectionChanged" IsEnabled="False"
                                      AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.085}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox x:Name="ContainerDetailsText" Grid.Row="3" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D5DD" Background="White"
                                     AutomationProperties.Name="{ui:Text Ui.Xaml.MainWindow.086}"
                                     Text="{ui:Text Ui.Xaml.MainWindow.087}"/>
                        </Grid>
                    </TabItem>
                    </TabControl>

                    <Expander x:Name="FindingDetailCard" Grid.Row="3" Header="{ui:Text Ui.Xaml.MainWindow.088}" IsExpanded="True" Margin="0,7,0,0" Background="White" Expanded="FindingDetails_Expanded">
                        <ScrollViewer x:Name="FindingDetailScroll" Height="100" Margin="8,5,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="88" MaxWidth="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,14,0" MaxWidth="166" TextWrapping="Wrap" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.MainWindow.089}" />
                                <TextBlock x:Name="DetailDescriptionText" Grid.Column="1" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Margin="0,7,14,0" MaxWidth="166" TextWrapping="Wrap" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.MainWindow.090}" />
                                <TextBlock x:Name="DetailEvidenceText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Margin="0,7,14,0" MaxWidth="166" TextWrapping="Wrap" FontWeight="SemiBold" Text="SHA-256" />
                                <TextBlock x:Name="DetailHashText" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Margin="0,7,14,0" MaxWidth="166" TextWrapping="Wrap" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.MainWindow.091}" />
                                <TextBlock x:Name="DetailWorkshopText" Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </ScrollViewer>
                    </Expander>

                    <DockPanel x:Name="SelectionActionsBar" Grid.Row="4" Margin="0,8,0,0" LastChildFill="True">
                    <Border x:Name="RemediationAvailabilityPanel" DockPanel.Dock="Bottom" Margin="0,4,0,0" Padding="8,5" Background="#EFF6FF" BorderBrush="#B2CCFF" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding Visibility, ElementName=ActivityPanel}" Value="Visible"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style></Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="RemediationAvailabilityTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#1849A9"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="RemediationAvailabilityActionButton" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Click="RemediationAvailabilityAction_Click" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                        <Button x:Name="RemediateButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"
                                IsEnabled="False" Content="{ui:Text Ui.Xaml.MainWindow.092}" Click="Remediate_Click" ToolTipService.ShowOnDisabled="True">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button x:Name="CoverSelectedButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Content="{ui:Text Ui.Xaml.MainWindow.093}" ToolTip="{ui:Text Ui.Xaml.MainWindow.094}" IsEnabled="False" Click="CoverSelected_Click">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button x:Name="FollowUpDetailsButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Content="{ui:Text Ui.Xaml.MainWindow.095}" Click="FollowUpDetails_Click">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <WrapPanel>
                            <Button x:Name="ExportButton" Content="{ui:Text Ui.Xaml.MainWindow.096}" IsEnabled="False" Click="Export_Click" />
                            <WrapPanel>
                            <WrapPanel.Style><Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ResultTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></WrapPanel.Style>
                            <Button x:Name="SelectAllButton" Content="{ui:Text Ui.Xaml.MainWindow.097}" Click="SelectAll_Click" ToolTipService.ShowOnDisabled="True" />
                            <Button x:Name="ClearSelectionButton" Content="{ui:Text Ui.Xaml.MainWindow.098}" Click="ClearSelection_Click" />
                            <Button x:Name="ReviewFindingButton" Content="{ui:Text Ui.Xaml.MainWindow.099}" IsEnabled="False" Click="ReviewFinding_Click" ToolTip="{ui:Text Ui.Xaml.MainWindow.100}" ToolTipService.ShowOnDisabled="True" />
                            <Button x:Name="OccupancyButton" Content="{ui:Text Ui.Xaml.MainWindow.101}" IsEnabled="False" Click="Occupancy_Click" ToolTip="{ui:Text Ui.Xaml.MainWindow.102}" />
                            </WrapPanel>
                        </WrapPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{ui:Text Ui.Xaml.MainWindow.103}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <TextBlock TextWrapping="Wrap" Text="{ui:Text Ui.Xaml.MainWindow.104}" />
                    </Border>
                    <DataGrid x:Name="QuarantineGrid" Grid.Row="1" Margin="0,12,0,12" ItemsSource="{Binding QuarantineItems}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.105}" Binding="{Binding IncidentId}" Width="2*" MinWidth="140" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.106}" Binding="{Binding Created}" Width="156" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.107}" Binding="{Binding ItemCount}" Width="62" ElementStyle="{StaticResource GridCenteredText}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                            <DataGridTextColumn Header="{ui:Text Ui.Xaml.MainWindow.108}" Binding="{Binding Status}" Width="*" MinWidth="120" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridCheckBoxColumn Header="{ui:Text Ui.Xaml.MainWindow.109}" Binding="{Binding RebootObserved, Mode=OneWay}" Width="62" ElementStyle="{StaticResource GridReadOnlyCheckBox}" HeaderStyle="{StaticResource GridCenteredHeader}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2">
                        <Button Content="{ui:Text Ui.Xaml.MainWindow.110}" Click="RefreshQuarantine_Click" />
                        <Button Content="{ui:Text Ui.Xaml.MainWindow.111}" Click="OpenQuarantine_Click" />
                        <Button x:Name="RollbackButton" IsEnabled="False" Content="{ui:Text Ui.Xaml.MainWindow.112}" Click="Rollback_Click" />
                        <Button x:Name="DeleteIncidentButton" IsEnabled="False" Style="{StaticResource PrimaryButton}" Content="{ui:Text Ui.Xaml.MainWindow.113}" Click="DeleteIncident_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{ui:Text Ui.Xaml.MainWindow.114}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.MainWindow.115}" />
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="{ui:Text Ui.Xaml.MainWindow.116}" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="{ui:Text Ui.Xaml.MainWindow.117}" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="{ui:Text Ui.Xaml.MainWindow.118}" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22" FontWeight="SemiBold" Foreground="#B42318"
                                   Text="{ui:Text Ui.Xaml.MainWindow.119}" />
                        <TextBlock Margin="0,22,0,0" FontSize="18" FontWeight="SemiBold" Text="{ui:Text Ui.Xaml.MainWindow.120}" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="{ui:Text Ui.Xaml.MainWindow.121}" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{ui:Text Ui.Xaml.MainWindow.122}" />
                        <TextBlock Margin="0,8,0,0" Foreground="#667085" Text="Copyright © 2026 fenglinbei" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{ui:Text Ui.Language.Tab}">
                <ui:LanguageSettingsView />
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#E4E7EC" Padding="12,4">
            <TextBlock x:Name="FooterText" Foreground="#475467" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{ui:Text Ui.Xaml.MainWindow.123}" />
        </Border>
    </Grid>
</Window>
