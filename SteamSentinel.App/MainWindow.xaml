<Window x:Class="SteamSentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamSentinel Steam 红信安全工具"
        Icon="/SteamSentinel;component/Assets/App.ico"
        Width="1180" Height="880" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Background="#101828" Padding="24,14" MinHeight="112">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45*" />
                    <ColumnDefinition Width="55*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/SteamSentinel;component/Assets/App.png" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="SteamSentinel 图标" />
                    <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="White" FontSize="25" FontWeight="SemiBold" Text="SteamSentinel" />
                        <Border Margin="12,2,0,0" Background="#B42318" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Text="0.1.16" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0" Foreground="#D0D5DD" TextWrapping="Wrap" Text="扫描 Steam 创意工坊、MOD 与插件，隔离威胁并恢复 Steam" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="HeaderStatusText" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Text="尚未扫描" />
                    <TextBlock x:Name="HeaderDetailText" Margin="18,4,0,0" Foreground="#D0D5DD" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" Text="规则载入中" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ActivityPanel" Grid.Row="1" Visibility="Collapsed" Margin="18,8,18,0" Padding="12"
                Background="#EFF6FF" BorderBrush="#B2CCFF" BorderThickness="1" CornerRadius="8"
                AutomationProperties.Name="当前操作状态">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ActivitySpinner" Width="26" Height="26" Margin="0,0,12,0" Grid.RowSpan="2" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform x:Name="ActivityRotation"/></Grid.RenderTransform>
                    <Ellipse Width="22" Height="22" Stroke="#D1E0FF" StrokeThickness="3"/>
                    <Path Data="M13,2 A11,11 0 0 1 24,13" Stroke="#175CD3" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
                <TextBlock x:Name="ActivityTitleText" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="#1849A9" TextWrapping="Wrap"/>
                <TextBlock x:Name="ActivityElapsedText" Grid.Column="2" Margin="12,0,0,0" Foreground="#475467" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActivityDetailText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="#475467" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ActivityProgressBar" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Height="4" Foreground="#175CD3" Background="#D1E0FF" IsIndeterminate="False"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="18">
            <TabItem Header="扫描与处置">
                <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="14" MinHeight="640" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="220" />
                        <RowDefinition Height="*" MinHeight="90" MaxHeight="180" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel>
                                <Button x:Name="QuickScanButton" Style="{StaticResource PrimaryButton}" Content="快速扫描" Click="QuickScan_Click" />
                                <Button x:Name="FullScanButton" Content="完整内容扫描" Click="FullScan_Click" />
                                <Button x:Name="FileScanButton" Content="扫描文件" Click="FileScan_Click" />
                                <Button x:Name="FolderScanButton" Content="扫描目录" Click="FolderScan_Click" />
                                <Button x:Name="RetryPasswordsButton" Content="重试未解密内容" IsEnabled="False" Click="RetryPasswords_Click" />
                                <Button x:Name="CancelScanButton" Content="取消" IsEnabled="False" Click="CancelScan_Click" />
                            </WrapPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock x:Name="ScanScopeText" TextWrapping="Wrap" Foreground="#475467" Text="快速扫描：Steam 客户端与相关运行状态，以及本地工坊、MOD 和插件。视频先查格式、结构与尾随数据，不是全盘扫描。" />
                            <Expander Header="扫描范围与选项" Margin="0,6,0,0">
                            <StackPanel Margin="0,6,0,0">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="快速扫描优先检查关联落点和启动型内容，文件哈希预算 1 GiB，另为小型启动文件保留 128 MiB，单文件超过 256 MiB 时不完整读取。完整内容扫描不再设置整轮哈希字节上限，但只检查所选范围，不是全盘查杀。加密内容需要正确密码，格式、权限、文件数与解压安全上限仍可能限制检查。" />
                            <WrapPanel>
                                <TextBlock Text="工坊范围" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <ComboBox x:Name="WorkshopScopeComboBox" DisplayMemberPath="Label" SelectedValuePath="AppId" MinWidth="160" MaxWidth="250" Margin="0,0,18,8" ToolTip="只限制工坊内容，Steam 客户端、插件和关联启动项仍会检查。" />
                                <CheckBox x:Name="DownloadLocationsCheckBox" Margin="0,0,18,8" Content="额外检查下载、桌面和临时目录" ToolTip="会递归检查其中的资料、样本和开发目录，明显增加扫描时间。文件存在不代表已感染。" Checked="ScopeOptions_Changed" Unchecked="ScopeOptions_Changed" />
                                <CheckBox x:Name="ExecutionHistoryCheckBox" Margin="0,0,18,8" Content="检查可疑运行历史" ToolTip="默认关闭，只输出可疑执行链提示，不导出完整运行命令。" />
                                <CheckBox x:Name="ArchiveCheckBox" IsChecked="True" Margin="0,0,22,0" Content="递归检查压缩包" />
                                <CheckBox x:Name="AmsiCheckBox" IsChecked="True" Margin="0,0,22,0" Content="使用本机反恶意软件接口（AMSI）辅助扫描" />
                                <CheckBox x:Name="DomainBlockCheckBox" IsChecked="True" Content="处置时阻断已知恶意域名" />
                            </WrapPanel>
                            </StackPanel>
                            </Expander>
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="InstallationSecurityText" FontWeight="SemiBold" TextWrapping="Wrap" Text="正在检查安装环境…" />
                                    <TextBlock x:Name="ElevationHintText" Margin="0,4,0,0" Foreground="#475467" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ElevateButton" Content="打开管理员窗口" IsEnabled="False" Click="Elevate_Click" />
                                    <Button x:Name="RefreshInstallationButton" Content="重新检查" IsEnabled="False" Click="RefreshInstallation_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ProgressStageText" FontWeight="SemiBold" Text="等待扫描" />
                            <TextBlock x:Name="ProgressItemText" Margin="0,4,0,0" Foreground="#667085" TextTrimming="CharacterEllipsis" />
                            <ProgressBar x:Name="ScanProgressBar" Margin="0,8,0,0" Height="5" IsIndeterminate="False" />
                        </StackPanel>
                        <TextBlock x:Name="FindingCountText" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="0 项发现" />
                    </Grid>

                    <TabControl Grid.Row="2" x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
                    <TabItem Header="风险与提示">
                    <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding Findings}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionChanged="FindingsGrid_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="处置" Width="54">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="严重度" Binding="{Binding Severity}" IsReadOnly="True" Width="112" />
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="分数" Binding="{Binding Score}" IsReadOnly="True" Width="62" />
                            <DataGridTextColumn Header="发现" Binding="{Binding Title}" IsReadOnly="True" Width="240" />
                            <DataGridTextColumn Header="目标" Binding="{Binding Target}" IsReadOnly="True" Width="*" MinWidth="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </TabItem>
                    <TabItem x:Name="CoverageTab" Header="未检查内容">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="CoverageStatusText" Text="尚无结果。这里列出未深查、加密或读取受限的内容，不计入风险数量。" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid x:Name="CoverageGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="CoverageGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="原因" Binding="{Binding Kind}" Width="260" />
                                    <DataGridTextColumn Header="记录数" Binding="{Binding Count}" Width="75" />
                                    <DataGridTextColumn Header="下一步" Binding="{Binding NextStep}" Width="*" MinWidth="380">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button x:Name="CoverSelectedButton" Grid.Row="2" Content="使用完整内容扫描以覆盖此项" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="False" Click="CoverSelected_Click" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="BatchResultsTab" Header="处置结果">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="BatchSummaryText" Text="尚未生成处置方案，这里会逐项列出已选目标的处理结果。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                    <TextBlock x:Name="BatchFollowUpText" Text="原扫描范围复查与系统复查会分开显示，动作成功不代表全部威胁已清除。" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                            <DataGrid x:Name="BatchResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="95"/>
                                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*" MinWidth="220">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Target}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="结果与原因" Binding="{Binding Reason}" Width="*" MinWidth="260">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Reason}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    </TabControl>

                    <Border x:Name="FindingDetailCard" Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="意味着什么" />
                                <TextBlock x:Name="DetailDescriptionText" Grid.Column="1" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Margin="0,7,0,0" FontWeight="SemiBold" Text="证据" />
                                <TextBlock x:Name="DetailEvidenceText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Margin="0,7,0,0" FontWeight="SemiBold" Text="SHA-256" />
                                <TextBlock x:Name="DetailHashText" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Margin="0,7,0,0" FontWeight="SemiBold" Text="工坊 ID" />
                                <TextBlock x:Name="DetailWorkshopText" Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" />
                            </Grid>
                        </ScrollViewer>
                    </Border>

                </Grid>
                </ScrollViewer>
                    <Grid Grid.Row="1" Margin="14,8,14,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="全选可处置项" Click="SelectAll_Click" />
                            <Button Content="清除选择" Click="ClearSelection_Click" />
                            <Button x:Name="ExportButton" Content="导出报告" IsEnabled="False" Click="Export_Click" />
                            <Button x:Name="ReviewFindingButton" Content="进一步检查" IsEnabled="False" Click="ReviewFinding_Click" ToolTip="检查当前选中项的实际文件和关联启动入口，不执行文件，也不会自动隔离。" />
                            <Button x:Name="OccupancyButton" Content="查看占用" IsEnabled="False" Click="Occupancy_Click" ToolTip="只读查询谁正在使用所选文件，不关闭程序或句柄。" />
                        </StackPanel>
                        <Button x:Name="RemediateButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Content="预览并处置所选项" Click="Remediate_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="隔离与回滚">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <TextBlock TextWrapping="Wrap" Text="已处理的威胁会先移入隔离区，回滚不会覆盖已经重新出现的原路径。只有在检测到系统重启，且最近一次完整扫描未发现已确认威胁时，才会开放永久删除。" />
                    </Border>
                    <DataGrid x:Name="QuarantineGrid" Grid.Row="1" Margin="0,12,0,12" ItemsSource="{Binding QuarantineItems}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="事件 ID" Binding="{Binding IncidentId}" Width="300" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding Created}" Width="180" />
                            <DataGridTextColumn Header="记录数" Binding="{Binding ItemCount}" Width="90" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                            <DataGridCheckBoxColumn Header="已重启" Binding="{Binding RebootObserved, Mode=OneWay}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="刷新" Click="RefreshQuarantine_Click" />
                        <Button Content="打开隔离目录" Click="OpenQuarantine_Click" />
                        <Button x:Name="RollbackButton" IsEnabled="False" Content="回滚所选事件" Click="Rollback_Click" />
                        <Button x:Name="DeleteIncidentButton" IsEnabled="False" Background="#B42318" Foreground="White" Content="永久删除所选事件" Click="DeleteIncident_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="边界与安全">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="本工具能做什么，不能做什么" />
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="本程序不会运行被扫描的媒体、脚本或可执行文件。压缩内容会在 Low Integrity 受限令牌的独立工作进程中读取，进程先加入单进程 Job Object，再接收扫描路径，并在主程序退出时终止。普通扫描不会请求管理员权限。" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="只有安装环境与组件完整性检查通过后，才能请求管理员授权。处置时可自动请求 UAC，也可点击“打开管理员窗口”后重新扫描，原窗口与报告会保留。标准账户需提供管理员凭据，工具不会收集密码。管理员处置组件仍会核对请求者、计划 SHA-256、精确路径、文件哈希或目录指纹。" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="本程序聚焦 Steam、Wallpaper Engine 与已观察到的假红信链路，可完成一次快速扫描、辨别、隔离和 Steam 恢复。“完整扫描，未发现已知威胁”仍不代表电脑绝对安全。加密内容未解开、格式不受支持、缺少分卷或触发资源限制时，报告会标记为“未完整扫描”。" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22" FontWeight="SemiBold" Foreground="#B42318"
                                   Text="启发式发现会继续保留处置能力，但默认不预选。即使处置显示成功，也只代表本次计划中的目标已处理，不代表整台电脑已经无毒。条件允许时，仍建议再用保持更新的专业杀毒软件进行全盘复核。" />
                        <TextBlock Margin="0,22,0,0" FontSize="18" FontWeight="SemiBold" Text="开源与许可" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="本工具由 fenglinbei 开源，采用 Apache License 2.0。你可以查看源码，并按许可证约定使用、修改和分享。完整条款见安装目录中的 LICENSE，版权及第三方声明见 NOTICE 和 THIRD-PARTY-NOTICES.md。" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="开源页面：https://github.com/fenglinbei/SteamSentinel" />
                        <TextBlock Margin="0,8,0,0" Foreground="#667085" Text="Copyright © 2026 fenglinbei" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#E4E7EC" Padding="12,6">
            <TextBlock x:Name="FooterText" Foreground="#475467" Text="本地运行 · 默认不上传样本或账户数据 · 隔离可回滚" />
        </Border>
    </Grid>
</Window>
